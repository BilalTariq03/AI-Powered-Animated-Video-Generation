# Required
GROQ_API_KEY=your_groq_key_here

# Recommended — enables HF FLUX.1-schnell image generation
# Falls back to Pollinations.ai (free, no key) if not set
HF_API_KEY=your_huggingface_key_here

# Optional — enables ElevenLabs premium TTS
# Falls back to Kokoro (local neural) if not set
ELEVENLABS_API_KEY=
